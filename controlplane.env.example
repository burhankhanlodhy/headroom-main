# Copy to .env next to docker-compose.controlplane.yml and fill in.
# Generate a password:  python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=contextshrink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contextshrink

# Dashboard dev origins; add https://app.contextshrink.com when launched
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_TTL_DAYS=30

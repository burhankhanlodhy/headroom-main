# Copy to .env next to docker-compose.controlplane.yml and fill in.
# Generate a password:  python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=contextshrink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contextshrink

# Loopback only on dev machines. On the deployment Pi (behind the web tier's
# reverse proxy) set this to 0.0.0.0 so Pi 4's Caddy can reach the API.
API_BIND=127.0.0.1

# Dashboard dev origins; add https://app.contextshrink.com when launched.
# Not needed when the dashboard reaches the API through the same-origin
# /api reverse proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_TTL_DAYS=30

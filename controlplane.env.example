# Copy to .env next to docker-compose.controlplane.yml and fill in.
# Generate a password:  python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=contextshrink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contextshrink

# Loopback only on dev machines. On the deployment Pi (behind the web tier's
# reverse proxy) set this to 0.0.0.0 so Pi 4's Caddy can reach the API.
API_BIND=127.0.0.1

# Dashboard dev origins; add https://app.contextshrink.com when launched.
# Not needed when the dashboard reaches the API through the same-origin
# /api reverse proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_TTL_DAYS=30

# Free accounts get compression until they save this much (USD) in the
# current UTC month; later requests pass through uncompressed.
FREE_SAVINGS_CAP_USD=20

# Must match the proxy's server-only credential (openssl rand -hex 48).
CONTEXTSHRINK_SERVICE_TOKEN=change-me

# Stripe sandbox keys are server-managed by the API environment. Never put the
# secret key in frontend variables, source code, chat, or a committed .env file.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint (whsec_...). Created by
# api/stripe_setup.py --webhook-url ... --print-webhook-secret.
STRIPE_WEBHOOK_SECRET=

# Public dashboard origin used for Checkout and Customer Portal return URLs.
APP_URL=https://app.contextshrink.com

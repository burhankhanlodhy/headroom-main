# ContextShrink web tier — Pi 4 (192.168.0.64)
:80 {
	encode gzip
	root * /var/www/contextshrink/landing
	try_files {path} /index.html
	file_server
}

:8080 {
	encode gzip

	@analytics path /dashboard /dashboard/* /account-api/*
	handle @analytics {
		reverse_proxy 192.168.0.71:8787
	}

	# The proxy has its own hostname (proxy.contextshrink.com, the Pi 5's
	# Cloudflare Tunnel). Answer the retired /proxy path with a clear 404
	# instead of falling through to the dashboard app.
	handle /proxy/* {
		respond "Not Found: use https://proxy.contextshrink.com" 404
	}

	@private_routes path /api/internal/* /api/ingest/* /stats /stats-lifetime /stats-history /health /transformations/* /metrics /admin/* /debug/*
	handle @private_routes {
		respond "Not Found" 404
	}

	handle_path /api/* {
		reverse_proxy 192.168.0.71:8788
	}

	handle {
		root * /var/www/contextshrink/dashboard
		try_files {path} /index.html
		file_server
	}
}

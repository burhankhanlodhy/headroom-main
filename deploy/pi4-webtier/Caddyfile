# ContextShrink web tier — Pi 4 (192.168.0.64)
#
# Static files only. The Pi 4 never connects to the Pi 5: the dashboard and
# the Advanced Analytics page call https://api.contextshrink.com, and tools use
# https://proxy.contextshrink.com; both are the Pi 5's own Cloudflare Tunnel.
:80 {
	encode gzip
	root * /var/www/contextshrink/landing
	try_files {path} /index.html
	file_server
}

:8080 {
	encode gzip
	root * /var/www/contextshrink/dashboard

	# Advanced Analytics: a static page shipped with the dashboard build.
	@analytics path /dashboard /dashboard/
	handle @analytics {
		header Cache-Control "no-store"
		rewrite * /dashboard/index.html
		file_server
	}

	# Desktop app installers and latest.json, published by
	# desktop/publish-installer.ps1 into /var/www/contextshrink/releases
	# (outside the dashboard folder, so dashboard deploys never remove them).
	handle /releases/* {
		root * /var/www/contextshrink
		@latest path /releases/latest.json
		header @latest Cache-Control "no-cache"
		@installer path *.exe
		header @installer Cache-Control "public, max-age=31536000, immutable"
		header @installer Content-Disposition "attachment"
		file_server
	}

	# Retired relay paths: answer clearly instead of serving the app.
	handle /proxy/* {
		respond "Not Found: use https://proxy.contextshrink.com" 404
	}
	handle /api/* {
		respond "Not Found: use https://api.contextshrink.com" 404
	}
	handle /account-api/* {
		respond "Not Found: use https://api.contextshrink.com" 404
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

# ContextShrink web tier — Pi 4 (192.168.0.64)
:80 {
	encode gzip
	root * /var/www/contextshrink/landing
	try_files {path} /index.html
	file_server
}

:8080 {
	encode gzip

	@analytics path /dashboard /dashboard/* /account-api/*
	handle @analytics {
		reverse_proxy 192.168.0.71:8787
	}

	# Separate data-plane URL; browser session tokens are not proxy keys.
	handle_path /proxy/* {
		reverse_proxy 192.168.0.71:8787
	}

	@private_routes path /api/internal/* /api/ingest/* /stats /stats-lifetime /stats-history /health /transformations/* /metrics /admin/* /debug/*
	handle @private_routes {
		respond "Not Found" 404
	}

	handle_path /api/* {
		reverse_proxy 192.168.0.71:8788
	}

	handle {
		root * /var/www/contextshrink/dashboard
		try_files {path} /index.html
		file_server
	}
}

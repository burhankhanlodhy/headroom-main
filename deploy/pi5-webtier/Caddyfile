# Pi 5 gateway. Account analytics never reaches Horizon's global /stats.
#
#   192.168.0.71:8787  LAN, Pi 4 web tier only: the Advanced Analytics page
#                      and its read-only account calls. No proxy traffic.
#   127.0.0.1:8791     loopback, Pi 5 Cloudflare Tunnel (api.contextshrink.com):
#                      public control-plane API routes only.
#   127.0.0.1:8790     loopback, Pi 5 Cloudflare Tunnel (proxy.contextshrink.com):
#                      provider operations only. Never point the tunnel at the
#                      proxy itself (127.0.0.1:8787): this gateway is what
#                      allowlists provider operations and strips edge headers.

(account_routes) {
	@account_dashboard path /dashboard /dashboard/
	handle @account_dashboard {
		rewrite * /dashboard/account
		reverse_proxy 127.0.0.1:8787 {
			header_up Host 127.0.0.1:8787
		}
	}

	@account_reads {
		method GET
		path /account-api/auth/me /account-api/analytics/summary /account-api/analytics/feed /account-api/analytics/history.csv
	}
	handle @account_reads {
		uri strip_prefix /account-api
		reverse_proxy 127.0.0.1:8788
	}
}

(proxy_routes) {
	# Only supported provider operations may reach the data plane.
	# The outer ASGI middleware validates the account key, including on loopback.
	@proxy_operations path_regexp provider ^(/p/[^/]+)?(/(anthropic/)?v1/messages|/(v1/)?chat/completions|/(v1/(codex/)?|backend-api/(codex/)?)?responses|/v1(beta)?/models/[^/]+:(generateContent|streamGenerateContent|countTokens)|/v1/models(/[^/]+)?|/v1/messages/count_tokens)/?$
	handle @proxy_operations {
		reverse_proxy 127.0.0.1:8787 {
			header_up Host 127.0.0.1:8787
			# Edge headers from Cloudflare and the Caddy hops must not reach
			# providers: many sit behind Cloudflare too, and a forwarded
			# CDN-Loop/CF-* header makes Cloudflare refuse the request (HTML
			# 403). They would also leak the caller's IP and country upstream.
			header_up -Cdn-Loop
			header_up -Cf-Connecting-Ip
			header_up -Cf-Ipcountry
			header_up -Cf-Ray
			header_up -Cf-Visitor
			header_up -Cf-Warp-Tag-Id
			header_up -Cf-Ew-Via
			header_up -Cf-Worker
			header_up -True-Client-Ip
			header_up -Via
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-Ip
		}
	}
}

(api_routes) {
	# Public control-plane routes only; /internal/* (service token), the
	# legacy /ingest and FastAPI's /docs and /openapi.json stay private.
	@public_api path_regexp api ^/(healthz|auth/(signup|login|logout|me)|subscription|billing/(estimate|checkout|portal|renew|invoices)|usage/summary|keys(/[^/]+)?|analytics/(summary|feed|history\.csv)|stripe/webhook)$
	handle @public_api {
		reverse_proxy 127.0.0.1:8788 {
			header_up -Cdn-Loop
			header_up -Via
		}
	}
}

:8787 {
	bind 192.168.0.71
	import account_routes
	handle {
		respond "Not Found" 404
	}
}

:8790 {
	bind 127.0.0.1
	import proxy_routes
	handle {
		respond "Not Found" 404
	}
}

# api.contextshrink.com (Pi 5 Cloudflare Tunnel): the dashboard, the Advanced
# Analytics page and the desktop app call the control-plane API here.
:8791 {
	bind 127.0.0.1
	import api_routes
	handle {
		respond "Not Found" 404
	}
}
